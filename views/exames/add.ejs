<%- include('../partials/header') %>
<%- include('../partials/navbar') %>

<div class="container mt-4">

    <h2>Cadastrar Exame</h2>

    <form action="/exames/add" method="POST">

        <div class="mb-3">
           <label for="paciente" class="form-label">Paciente</label>

<select
    id="paciente"
    class="form-select"
    name="paciente"
    required>

               <option value="" selected disabled>
    Selecione um paciente...
</option>

                <% pacientes.forEach(p => { %>

                    <option value="<%= p._id %>">
                        <%= p.nome %>
                    </option>

                <% }) %>

            </select>
        </div>

        <div class="mb-3">
           <label for="tipo" class="form-label">Tipo de Exame</label>

<input
    id="tipo"
    type="text"
    class="form-control"
    name="tipo"
    maxlength="100"
    required
    placeholder="Ex.: Hemograma Completo">
        </div>

        <div class="mb-3">
            <label for="data" class="form-label">
    Data do Exame
</label>

<input
    id="data"
    type="date"
    class="form-control"
    name="data"
    max="<%= new Date().toISOString().split('T')[0] %>"
    required>
        </div>

        <div class="mb-3">
         <label for="resultado" class="form-label">
    Resultado
</label>

<textarea
    id="resultado"
    class="form-control"
    name="resultado"
    rows="4"
    maxlength="500"
    placeholder="Informe o resultado do exame (opcional)">
</textarea>
        </div>

      <button
    type="submit"
    class="btn btn-success me-2">
    Salvar Exame
</button>

        <a
            href="/exames/lst"
            class="btn btn-secondary">
            Voltar
        </a>

    </form>

</div>

<%- include('../partials/footer') %>