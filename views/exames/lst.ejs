<%- include('../partials/header') %>
<%- include('../partials/navbar') %>

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>
            Lista de Exames
            <span class="badge bg-secondary">
                <%= exames.length %>
            </span>
        </h2>

        <a href="/exames/add" class="btn btn-primary">
            Novo Exame
        </a>
    </div>

    <% if (exames.length === 0) { %>

        <div class="alert alert-info">
            Nenhum exame cadastrado.
        </div>

    <% } else { %>

        <!-- Barra de Pesquisa / Filtro -->
        <div class="row mb-3">
            <div class="col-md-6">
                <div class="input-group">
                    <span class="input-group-text bg-white">🔍</span>
                    <input 
                        type="text" 
                        id="campoBusca" 
                        class="form-control" 
                        placeholder="Pesquisar por paciente, tipo de exame, data ou resultado...">
                    <button class="btn btn-outline-secondary" type="button" id="btnLimparBusca">Limpar</button>
                </div>
            </div>
        </div>

        <div class="table-responsive">

            <table class="table table-striped table-hover align-middle">

                <thead class="table-dark">
                    <tr>
                        <th>Paciente:</th>
                        <th>Tipo de Exame:</th>
                        <th>Data:</th>
                        <th>Resultado:</th>
                        <th>Ações:</th>
                    </tr>
                </thead>

                <tbody>

                    <% exames.forEach(exame => { %>

                        <tr>

                            <td>
                                <%= exame.paciente ? exame.paciente.nome : 'Sem paciente' %>
                            </td>

                            <td>
                                <%= exame.tipo %>
                            </td>

                            <td>
                                <%= exame.data
                                    ? new Date(exame.data).toLocaleDateString('pt-BR', {
                                        timeZone: 'UTC'
                                    })
                                    : '' %>
                            </td>

                            <td>
                                <%= exame.resultado || 'Não informado' %>
                            </td>

                            <td>

                                <a
                                    href="/exames/edt/<%= exame._id %>"
                                    class="btn btn-warning btn-sm me-1">
                                    Editar
                                </a>

                                <a
                                    href="/exames/del/<%= exame._id %>"
                                    class="btn btn-danger btn-sm"
                                    onclick="return confirm('Tem certeza que deseja excluir este exame?')">
                                    Excluir
                                </a>

                            </td>

                        </tr>

                    <% }) %>

                </tbody>

            </table>

        </div>

    <% } %>

</div>

<%- include('../partials/footer') %>