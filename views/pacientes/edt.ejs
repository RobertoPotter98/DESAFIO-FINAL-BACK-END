<%- include('../partials/header') %>
<%- include('../partials/navbar') %>

<div class="container mt-4">

    <h2 class="mb-4">Editar Paciente</h2>

    <form action="/pacientes/edt/<%= paciente._id %>" method="POST">

        <div class="mb-3">

            <label for="nome" class="form-label">
                Nome
            </label>

            <input
                type="text"
                class="form-control"
                id="nome"
                name="nome"
                value="<%= paciente.nome %>"
                maxlength="100"
                placeholder="Digite o nome completo"
                required>

        </div>

        <div class="mb-3">

            <label for="cpf" class="form-label">
                CPF
            </label>

            <input
                type="text"
                class="form-control"
                id="cpf"
                name="cpf"
                value="<%= paciente.cpf %>"
                maxlength="14"
                placeholder="000.000.000-00"
                required>

        </div>

        <div class="mb-3">

            <label for="telefone" class="form-label">
                Telefone
            </label>

            <input
                type="text"
                class="form-control"
                id="telefone"
                name="telefone"
                value="<%= paciente.telefone %>"
                maxlength="15"
                placeholder="(51) 99999-9999"
                required>

        </div>

        <div class="mb-3">

            <label for="dataNascimento" class="form-label">
                Data de Nascimento
            </label>

            <input
                type="date"
                class="form-control"
                id="dataNascimento"
                name="dataNascimento"
                value="<%= paciente.dataNascimento ? paciente.dataNascimento.toISOString().split('T')[0] : '' %>"
                max="<%= new Date().toISOString().split('T')[0] %>">

        </div>

        <button
            type="submit"
            class="btn btn-primary me-2">

            Salvar Alterações

        </button>

        <a
            href="/pacientes/lst"
            class="btn btn-secondary">

            Cancelar

        </a>

    </form>

</div>

<%- include('../partials/footer') %>