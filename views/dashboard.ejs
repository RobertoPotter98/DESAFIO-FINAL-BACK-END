<%- include('./partials/header') %>
<%- include('./partials/navbar') %>

<div class="container mt-5">
   <div class="text-center mb-5">

    <h1 class="display-4 fw-bold text-primary">
        Sistema de Gestão Clínica
    </h1>

    <p class="lead text-muted">
        Selecione um módulo abaixo para gerenciar os registros.
    </p>

    <p class="text-secondary">
        Bem-vindo ao sistema de gestão clínica. Utilize os módulos abaixo para cadastrar e gerenciar pacientes, consultas e exames.
    </p>

</div>

    <div class="row g-4">
        <!-- Card Pacientes -->
        <div class="col-md-4">
            <div class="card h-100 shadow-sm text-center">
                <div class="card-body d-flex flex-column justify-content-between">
                    <div>
                      <h4 class="card-title text-primary">
    👤 Pacientes
</h4>
                        <p class="card-text">Cadastre novos pacientes, consulte dados e atualize informações.</p>
                    </div>
                    <div class="mt-3">
                        <a href="/pacientes/lst" class="btn btn-primary w-100 mb-2">Ver Pacientes</a>
                        <a href="/pacientes/add" class="btn btn-outline-primary w-100">Novo Paciente</a>
                    </div>
                </div>
            </div>
        </div>

        <!-- Card Exames -->
        <div class="col-md-4">
            <div class="card h-100 shadow-sm text-center">
                <div class="card-body d-flex flex-column justify-content-between">
                    <div>
                        <h4 class="card-title text-success">
    🧪 Exames
</h4>
                        <p class="card-text">Gerencie solicitações de exames, datas e resultados vinculados aos pacientes.</p>
                    </div>
                    <div class="mt-3">
                        <a href="/exames/lst" class="btn btn-success w-100 mb-2">Ver Exames</a>
                        <a href="/exames/add" class="btn btn-outline-success w-100">Novo Exame</a>
                    </div>
                </div>
            </div>
        </div>

        <!-- Card Consultas -->
        <div class="col-md-4">
            <div class="card h-100 shadow-sm text-center">
                <div class="card-body d-flex flex-column justify-content-between">
                    <div>
                       <h4 class="card-title text-info">
    📅 Consultas
</h4>
                        <p class="card-text">Agende consultas médicas, controle especialidades e observações.</p>
                    </div>
                    <div class="mt-3">
                        <a href="/consultas/lst" class="btn btn-info text-white w-100 mb-2">Ver Consultas</a>
                        <a href="/consultas/add" class="btn btn-outline-info w-100">Agendar Consulta</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<%- include('./partials/footer') %>