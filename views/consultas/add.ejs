<%- include('../partials/header') %>
<%- include('../partials/navbar') %>

<div class="container mt-4">
    <h2 class="mb-4">
    Agendar Consulta
</h2>

    <form action="/consultas/add" method="POST">

        <div class="mb-3">
           <label for="paciente" class="form-label">
    Paciente
</label>

<select
    id="paciente"
    class="form-select"
    name="paciente"
    required>

                <option value="" selected disabled>
    Selecione um paciente...
</option>

                <% pacientes.forEach(p => { %>
                    <option value="<%= p._id %>">
                        <%= p.nome %>
                    </option>
                <% }) %>

            </select>
        </div>

        <div class="mb-3">
          <label for="medico" class="form-label">
    Médico
</label>

<input
    id="medico"
    type="text"
    class="form-control"
    name="medico"
    maxlength="100"
    placeholder="Ex.: Dr. João Silva"
    required>
        </div>

        <div class="mb-3">
           <label for="especialidade" class="form-label">
    Especialidade
</label>

<input
    id="especialidade"
    type="text"
    class="form-control"
    name="especialidade"
    maxlength="100"
    placeholder="Ex.: Cardiologia"
    required>
        </div>

        <div class="mb-3">
   <label for="data" class="form-label">Data da Consulta</label>

<input
    id="data"
    type="text"
    placeholder="dd/mm/aaaa"
    onfocus="(this.type='date')"
    onblur="if(!this.value)this.type='text'"
    class="form-control"
    name="data"
    min="<%= new Date().toISOString().split('T')[0] %>"
    required>
        </div>

        <div class="mb-3">
           <label for="observacoes" class="form-label">
    Observações
</label>

<textarea
    id="observacoes"
    class="form-control"
    name="observacoes"
    rows="4"
    maxlength="500"
    placeholder="Observações da consulta (opcional)">
</textarea>
        </div>

      <button
    type="submit"
    class="btn btn-success me-2">
    Agendar Consulta
</button>

<a
    href="/consultas/lst"
    class="btn btn-secondary">
    Voltar
</a>

    </form>
</div>

<%- include('../partials/footer') %>